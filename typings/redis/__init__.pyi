from typing import Any, Iterable

from .exceptions import RedisError


class Redis:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def ping(self) -> bool: ...
    def info(self) -> dict[str, Any]: ...
    def get(self, key: Any) -> Any: ...
    def set(self, key: Any, value: Any, ex: int | None = ...) -> bool: ...
    def setex(self, name: Any, time: Any, value: Any) -> bool: ...
    def delete(self, *keys: Any) -> int: ...
    def scan(self, cursor: Any, match: str | None = ..., count: int | None = ...) -> tuple[Any, list[Any]]: ...
    def scan_iter(self, match: str | None = ..., count: int | None = ...) -> Iterable[Any]: ...
    def close(self) -> None: ...
    def flushdb(self) -> None: ...
    def dbsize(self) -> int: ...


def from_url(url: str, *args: Any, **kwargs: Any) -> Redis: ...


__all__ = ["Redis", "RedisError", "from_url"]
