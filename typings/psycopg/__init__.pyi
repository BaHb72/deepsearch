from typing import Any, Awaitable, Protocol

class AsyncCursor(Protocol):
    async def execute(self, query: Any, *args: Any, **kwargs: Any) -> Any: ...
    async def fetchall(self) -> list[Any]: ...
    async def fetchone(self) -> Any: ...
    async def close(self) -> None: ...

class AsyncConnection(Protocol):
    async def __aenter__(self) -> "AsyncConnection": ...
    async def __aexit__(self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: Any | None) -> bool | None: ...
    async def cursor(self) -> AsyncCursor: ...
    async def close(self) -> None: ...

    @classmethod
    def connect(cls, dsn: str | None = ..., **kwargs: Any) -> Awaitable[AsyncConnection]: ...

class SyncConnection(Protocol):
    def cursor(self) -> Any: ...
    def close(self) -> None: ...

class psycopg(Protocol):
    AsyncConnection: type[AsyncConnection]
    Connection: type[SyncConnection]

__all__ = ["AsyncConnection", "AsyncCursor", "SyncConnection"]
