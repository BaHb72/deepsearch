app:
  name: DeepSearch
  author: BaHb
  env: dev
  debug: true
  data_dir: ./data/dev

runtime:
  mode: full

log:
  level: INFO
  format: verbose
  toFile: true
  toConsole: true
  active: true
  rotation: 00:00
  retention_days: 30
  enable_json: false
  archive:
    enabled: true
    format: zip
    archive_after_days: 30
    purge_after_days: 90
  modules:
    enabled: false
    directory: modules
    max_depth: 2
    rotation: 00:00
    retention_days: 30

message_bus:
  buses:
    zmq:
      type: zmq
      enabled: true
      config:
        host: localhost
        pub_port: 5556
        sub_port: 5557
  routes:
    - match: '*'
      buses:
        - zmq

webui:
  enabled: true
  backend_host: 0.0.0.0
  backend_port: 8000
  frontend_enabled: true
  frontend_host: localhost
  frontend_port: 3000
  enable_cors: true
  reload: false

database:
  main:
    enabled: true
    type: postgresql
    host: localhost
    port: 5432
    database: deepsearch
    username: your_database_username
    password: your_database_password
    auto_connect: true
    path: ./data/deepsearch.db
  cache:
    enabled: true
    host: localhost
    port: 6379
    username: default
    password: your_redis_password
    db: 0
    pool_size: 10
    socket_timeout: 5
    socket_connect_timeout: 5
    socket_keepalive: true
    retry_on_timeout: true
    health_check_interval: 30
    max_idle_time: 300
    idle_check_interval: 60
    startup_command: []
    wsl:
      enabled: false
      distro: Ubuntu
      auto_resolve_ip: true

data_sources:
  default: amazingdata
  fallback_order:
    - amazingdata
    - cloudflare
    - akshare
  circuit_breaker:
    enabled: true
    failure_threshold: 5
    recovery_timeout: 60
    half_open_attempts: 3
  failover:
    enabled: true
    timeout: 5
    retry_count: 3
    backoff_factor: 2
  providers:
    amazingdata:
      enabled: false
      priority: 1
      fallback_sources:
        - cloudflare
        - akshare
      config:
        implementation_mode: process
        connection:
          username: your_amazingdata_username
          password: your_amazingdata_password
          host: 101.230.159.234
          port: 8600
          timeout: 10
          heartbeat_interval: 60
          auto_reconnect: true
          reconnect_interval: 10
          max_retries: 3
        subscription:
          enabled: true
          batch_size: 100
          max_symbols: 500
        cache:
          enabled: true
          ttl: 300
    cloudflare:
      enabled: true
      priority: 2
      config:
        worker_url: https://your-cloudflare-worker.example.com
        timeout: 30
        retry_count: 3
        fallback_to_direct: true
    akshare:
      enabled: true
      priority: 3
      config:
        mode: proxy
        timeout: 30
        proxy:
          enabled: true
          worker_url: https://akshare-proxy.example.com
          timeout: 15
          retry_count: 3
          fallback_to_direct: true
          cache:
            enabled: true
            ttl: 300

market_data:
  realtime:
    enabled: true
    boards:
      - 主板
      - 创业板
      - 科创板
      - 北证
    include_markets:
      - SH_MAIN
      - SZ_MAIN
      - STAR
      - SZ_GEM
      - BSE
      - INDEX
      - ETF
    interval_seconds: 1.0
    request_timeout_seconds: 3.0
    initial_step_timeout_seconds: 12.0
    off_day_interval_seconds: 60.0
    no_trade_interval_seconds: 5.0
    auction_interval_seconds: 1.0
    continuous_interval_seconds: 1.0
    off_day_timeout_seconds: 0.5
    no_trade_timeout_seconds: 1.0
    auction_timeout_seconds: 2.0
    continuous_timeout_seconds: 3.5
    capital_windows:
      - name: 1m
        duration_seconds: 60
    order_window:
      name: 1m
      duration_seconds: 60
    capital_limit: 50
    order_limit: 100
    redis:
      url: redis://localhost:6379/6
      strength_ttl: 180
      imbalance_ttl: 180
      auction_ttl: 180
      max_strength_entries: 50

notifications:
  enabled: true
  default_channel: wechat
  wechat_token: your_wechat_token
  bark_token: your_bark_token
  categories:
    alert:
      enabled: true
      max_per_window: 5
      window_seconds: 300
      channels:
        - wechat
        - bark
    info:
      enabled: true
      max_per_window: 20
      window_seconds: 600
      channels:
        - wechat
        - bark
