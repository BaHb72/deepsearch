# =============================================================================
# DeepSearch Dask Worker Dockerfile
# =============================================================================
# 构建包含 deepsearch 核心模块的自定义 Dask Worker 镜像
# 仅安装 Worker 执行聚合任务所需的最小依赖
#
# 用法:
#   docker-compose build dask-scheduler
#   docker-compose up -d
# =============================================================================

FROM daskdev/dask:dev-py3.13

LABEL maintainer="DeepSearch Team"
LABEL description="Dask Worker with DeepSearch core modules"

WORKDIR /app

# 复制精简依赖文件
COPY docker/pyproject.worker.toml ./pyproject.toml

# =========================================================================
# Monorepo 结构: packages/core/ 作为核心模块
# =========================================================================

# 复制必要的 core 模块
COPY packages/core/__init__.py ./core/
COPY packages/core/observability/ ./core/observability/
COPY packages/core/constants/ ./core/constants/
COPY packages/core/utils/ ./core/utils/
COPY packages/core/messaging/ ./core/messaging/
COPY packages/core/ports/ ./core/ports/

# 应用层（聚合框架）
COPY packages/core/application/ ./core/application/

# 计算层（Dask 客户端）
COPY packages/core/compute/ ./core/compute/

# 配置层（仅运行时代码与脱敏模板，避免将 settings*.yaml 等敏感配置写入镜像层）
RUN mkdir -p core/config
COPY packages/core/config/*.py ./core/config/
COPY packages/core/config/models/ ./core/config/models/
COPY packages/core/config/services/ ./core/config/services/
COPY packages/core/config/settings.prod.yaml.example ./core/config/settings.prod.yaml.example
COPY packages/core/config/data_sources.yaml.example ./core/config/data_sources.yaml.example
RUN cp core/config/settings.prod.yaml.example core/config/settings.prod.yaml

# Infrastructure 模块存根 + Plugin 文件（Scheduler 反序列化需要完整模块路径）
RUN mkdir -p core/infrastructure/providers/implementations/amazingdata && \
    mkdir -p core/infrastructure/providers/implementations/qmt && \
    echo '"""Infrastructure stub for scheduler."""' > core/infrastructure/__init__.py && \
    echo '"""Providers stub."""' > core/infrastructure/providers/__init__.py && \
    echo 'class UnifiedDataFeed:\n    """Stub."""\n    pass' > core/infrastructure/providers/binder.py && \
    echo '"""Implementations stub."""' > core/infrastructure/providers/implementations/__init__.py && \
    echo '"""AmazingData stub."""' > core/infrastructure/providers/implementations/amazingdata/__init__.py && \
    echo '"""QMT stub."""' > core/infrastructure/providers/implementations/qmt/__init__.py

# 仅复制 dask_plugin.py（顶层依赖仅需 core.compute.plugins，已在镜像中）
COPY packages/core/infrastructure/providers/implementations/amazingdata/dask_plugin.py \
     ./core/infrastructure/providers/implementations/amazingdata/
COPY packages/core/infrastructure/providers/implementations/qmt/dask_plugin.py \
     ./core/infrastructure/providers/implementations/qmt/

# 安装依赖
RUN pip install --no-cache-dir -e .

# 默认启动 Dask Worker
CMD ["dask", "worker", "dask-scheduler:8786"]
