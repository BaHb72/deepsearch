# DeepSearch Environment Variables Example
# 复制此文件为 .env 并填入实际值

# 环境配置
ENV=dev  # dev | prod
DEBUG=false  # 生产环境必须为false

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=verbose  # verbose(dev) | json(prod)
LOG_RETENTION_DAYS=30
LOG_JSON=false  # 生产环境建议true

# PostgreSQL数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deepsearch
DB_USER=deepsearch_user
DB_PASSWORD=your_secure_password_here_min_16_chars
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis缓存配置
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here_min_16_chars
REDIS_DB=0
REDIS_POOL_SIZE=10

# AmazingData配置（主数据源）
AMAZINGDATA_ENABLED=true
AMAZINGDATA_USERNAME=your_username
AMAZINGDATA_PASSWORD=your_password
AMAZINGDATA_HOST=101.230.159.234
AMAZINGDATA_PORT=8600
AMAZINGDATA_NETWORK=telecom  # telecom | unicom
# AMAZINGDATA_LOCAL_PATH 可选：留空时自动使用系统默认数据目录
# Windows 示例：AMAZINGDATA_LOCAL_PATH=C:\\Data\\AmazingData
# macOS 示例：AMAZINGDATA_LOCAL_PATH=/Users/<you>/Library/Application Support/DeepSearch/AmazingData
# Linux 示例：AMAZINGDATA_LOCAL_PATH=/home/<you>/.local/share/DeepSearch/AmazingData
AMAZINGDATA_LOCAL_PATH=
AMAZINGDATA_USE_LOCAL=true

# CloudFlare代理配置（备用数据源）
CLOUDFLARE_ENABLED=true
CLOUDFLARE_URL=https://akshare-proxy.934073514.workers.dev
CLOUDFLARE_API_KEY=your_cloudflare_api_key_if_needed

# AKShare配置（备用数据源）
AKSHARE_ENABLED=true

# QMT配置（备用数据源）
QMT_ENABLED=false
QMT_HOST=localhost
QMT_PORT=8888

# Web服务配置
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8000
WEBUI_RELOAD=false  # 生产环境必须为false
WEBUI_WORKERS=4
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# 前端配置
FRONTEND_PORT=3000
FRONTEND_PROXY=http://localhost:8000

# ZeroMQ配置
ZMQ_ENABLED=false
ZMQ_PUB_PORT=5556
ZMQ_SUB_PORT=5557

# 监控配置
MONITORING_ENABLED=true
ALERTS_ENABLED=true

# 性能配置
MAX_WORKERS=10
THREAD_POOL_SIZE=20
