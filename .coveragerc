[run]
source = deepsearch
omit =
    */tests/*
    */__pycache__/*
    */site-packages/*
    */.venv/*
    */migrations/*
    */conftest.py
    */config/*
    */cli/*
    deepsearch/__main__.py
    deepsearch/__init__.py
    deepsearch/constants.py

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml