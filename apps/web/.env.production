# Production Environment Variables
# API Configuration
VITE_API_BASE_URL=https://api.deepsearch.com
VITE_WS_URL=wss://api.deepsearch.com

# Application Settings
VITE_APP_TITLE=DeepSearch Trading System
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=production
VITE_PORT=3001

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK=false
VITE_ENABLE_ANALYTICS=true

# API Timeout Settings (ms)
VITE_API_TIMEOUT=60000
VITE_API_RETRY_COUNT=5
VITE_API_RETRY_DELAY=2000

# Cache Settings
VITE_CACHE_TTL=600000
VITE_CACHE_MAX_SIZE=100

# WebSocket Settings
VITE_WS_RECONNECT_INTERVAL=10000
VITE_WS_MAX_RECONNECT_ATTEMPTS=20

# Production Tools
VITE_SHOW_ERROR_OVERLAY=false
VITE_SHOW_PERFORMANCE_MONITOR=false
