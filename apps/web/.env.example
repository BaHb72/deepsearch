# Example Environment Variables
# Copy this file to .env.development or .env.production and fill in values

# API Configuration
VITE_API_BASE_URL=
VITE_WS_URL=

# Application Settings
VITE_APP_TITLE=
VITE_APP_VERSION=
VITE_APP_ENV=

# Feature Flags
VITE_ENABLE_DEBUG=
VITE_ENABLE_MOCK=
VITE_ENABLE_ANALYTICS=

# API Timeout Settings (ms)
VITE_API_TIMEOUT=
VITE_API_RETRY_COUNT=
VITE_API_RETRY_DELAY=

# Cache Settings
VITE_CACHE_TTL=
VITE_CACHE_MAX_SIZE=

# WebSocket Settings
VITE_WS_RECONNECT_INTERVAL=
VITE_WS_MAX_RECONNECT_ATTEMPTS=

# Development/Production Tools
VITE_SHOW_ERROR_OVERLAY=
VITE_SHOW_PERFORMANCE_MONITOR=
