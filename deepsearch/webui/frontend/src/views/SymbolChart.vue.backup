<template>
  <div class="chart-container">
    <!-- 股票信息栏 -->
    <div v-if="stockInfo" class="stock-info-bar">
      <div class="stock-header">
        <div class="stock-title">
          <span class="stock-name">{{ stockInfo.name }}</span>
          <span class="stock-code">({{ stockInfo.symbol }})</span>
        </div>
        <div class="stock-tags">
          <span class="stock-market">{{ stockInfo.market }}</span>
          <span v-if="stockInfo.is_margin" class="stock-tag margin">融</span>
          <span v-if="stockInfo.is_hgt" class="stock-tag hgt">沪股通</span>
          <span v-if="stockInfo.is_sgt" class="stock-tag sgt">深股通</span>
        </div>
      </div>
    </div>

    <!-- 顶部工具栏 -->
    <div class="chart-toolbar">
      <div class="toolbar-left">
        <!-- 股票选择 -->
        <el-autocomplete
            v-model="symbol"
            :fetch-suggestions="queryStock"
            placeholder="输入代码/名称/拼音"
            style="width: 200px"
            clearable
            @select="handleStockSelect"
            @keyup.enter="loadData"
            :trigger-on-focus="false"
            value-key="value"
        >
          <template #prepend>股票</template>
          <template #default="{ item }">
            <div style="display: flex; justify-content: space-between;">
              <span>{{ item.name }}</span>
              <span style="color: #909399; margin-left: 10px;">{{ item.code }}</span>
            </div>
          </template>
        </el-autocomplete>

        <!-- 周期选择 -->
        <div class="timeframe-selector">
          <el-button-group class="timeframe-group">
            <el-button
                v-for="tf in mainTimeframes"
                :key="tf.value"
                :type="timeframe === tf.value ? 'primary' : ''"
                @click="changeTimeframe(tf.value)"
                size="small"
            >
              {{ tf.label }}
            </el-button>
            <el-button
                :type="showMoreTimeframes ? 'primary' : ''"
                @click="showMoreTimeframes = !showMoreTimeframes"
                size="small"
            >
              更多
            </el-button>
          </el-button-group>
          
          <!-- 更多周期选项 -->
          <el-button-group v-if="showMoreTimeframes" class="timeframe-group-more">
            <el-button
                v-for="tf in moreTimeframes"
                :key="tf.value"
                :type="timeframe === tf.value ? 'primary' : ''"
                @click="changeTimeframe(tf.value)"
                size="small"
            >
              {{ tf.label }}
            </el-button>
          </el-button-group>
        </div>

        <!-- 复权选择 -->
        <el-select v-model="adjust" style="width: 100px" @change="loadData">
          <el-option label="除权" value="none"/>
          <el-option label="前复权" value="qfq"/>
          <el-option label="后复权" value="hfq"/>
        </el-select>

        <!-- 主图指标选择 -->
        <el-select v-model="mainIndicator" style="width: 120px" @change="changeMainIndicator">
          <el-option label="不显示指标" value="none"/>
          <el-option label="均线" value="MA"/>
          <el-option label="EXPMA" value="EXPMA"/>
          <el-option label="BOLL" value="BOLL"/>
          <el-option label="ENE" value="ENE"/>
        </el-select>
      </div>

      <div class="toolbar-right">
        <!-- 指标管理 -->
        <el-button @click="showIndicatorManager = true">
          <el-icon>
            <Setting/>
          </el-icon>
          指标管理
        </el-button>

        <!-- 模板选择 -->
        <el-select v-model="currentTemplate" placeholder="选择模板" style="width: 120px" @change="applyTemplate">
          <el-option
              v-for="tmpl in templates"
              :key="tmpl.id"
              :label="tmpl.name"
              :value="tmpl.id"
          />
        </el-select>

        <!-- 实时/历史切换 -->
        <el-switch
            v-model="realtime"
            active-text="实时"
            inactive-text="历史"
            @change="toggleRealtime"
        />

        <!-- 筹码峰开关 -->
        <el-switch
            v-model="showChipChart"
            active-text="筹码峰"
            @change="toggleChipChart"
        />

        <!-- 刷新按钮 -->
        <el-button :loading="loading" @click="loadData">
          <el-icon>
            <Refresh/>
          </el-icon>
        </el-button>
      </div>
    </div>

    <!-- 主图表区域 -->
    <div class="chart-main">
      <el-row :gutter="20">
        <!-- 图表部分 -->
        <el-col :span="showChipChart ? (showSidebar ? 14 : 18) : (showSidebar ? 18 : 24)">
          <div ref="chartContainer" :style="{ height: chartHeight + 'px' }" class="echarts-container"></div>
        </el-col>

        <!-- 筹码峰图表 -->
        <el-col v-if="showChipChart" :span="showSidebar ? 5 : 6">
          <div ref="chipChartContainer" :style="{ height: chartHeight + 'px' }" class="chip-chart-container"></div>
        </el-col>

        <!-- 右侧信息栏 -->
        <el-col v-if="showSidebar" :span="showChipChart ? 5 : 6">
          <div class="sidebar">
            <!-- 实时行情 -->
            <el-card v-if="snapshot" class="quote-card">
              <div slot="header">
                <span>{{ snapshot.name }} ({{ snapshot.symbol }})</span>
              </div>
              <div class="quote-price">
                <span class="price">{{ formatNumber(snapshot.price) }}</span>
                <span :class="getChangeClass(snapshot.change_pct)" class="change">
                  {{ snapshot.change > 0 ? '+' : '' }}{{ formatNumber(snapshot.change) }}
                  ({{ snapshot.change_pct > 0 ? '+' : '' }}{{ snapshot.change_pct }}%)
                </span>
              </div>
              <div class="quote-details">
                <div class="detail-item">
                  <span class="label">开盘</span>
                  <span class="value">{{ formatNumber(snapshot.open) }}</span>
                </div>
                <div class="detail-item">
                  <span class="label">最高</span>
                  <span class="value">{{ formatNumber(snapshot.high) }}</span>
                </div>
                <div class="detail-item">
                  <span class="label">最低</span>
                  <span class="value">{{ formatNumber(snapshot.low) }}</span>
                </div>
                <div class="detail-item">
                  <span class="label">成交量</span>
                  <span class="value">{{ formatVolume(snapshot.volume) }}</span>
                </div>
                <div class="detail-item">
                  <span class="label">成交额</span>
                  <span class="value">{{ formatAmount(snapshot.amount) }}</span>
                </div>
                <div class="detail-item">
                  <span class="label">换手率</span>
                  <span class="value">{{ snapshot.turnover_rate }}%</span>
                </div>
                <div class="detail-item">
                  <span class="label">VWAP</span>
                  <span class="value">{{ formatNumber(snapshot.vwap) }}</span>
                </div>
              </div>
            </el-card>

            <!-- 股票基本信息 -->
            <el-card v-if="stockInfo" class="stock-info-card">
              <template #header>
                <span>基本信息</span>
              </template>
              <div class="info-grid">
                <div class="info-item">
                  <span class="label">所属板块</span>
                  <span class="value">{{ stockInfo.industry || '-' }}</span>
                </div>
                <div class="info-item">
                  <span class="label">细分行业</span>
                  <span class="value">{{ stockInfo.sector || '-' }}</span>
                </div>
                <div class="info-item">
                  <span class="label">总市值</span>
                  <span class="value">{{ formatMarketCap(stockInfo.market_cap) }}</span>
                </div>
                <div class="info-item">
                  <span class="label">流通市值</span>
                  <span class="value">{{ formatMarketCap(stockInfo.float_market_cap) }}</span>
                </div>
                <div class="info-item">
                  <span class="label">市盈率</span>
                  <span class="value">{{ stockInfo.pe_ratio || '-' }}</span>
                </div>
                <div class="info-item">
                  <span class="label">市净率</span>
                  <span class="value">{{ stockInfo.pb_ratio || '-' }}</span>
                </div>
                <div class="info-item">
                  <span class="label">ROE</span>
                  <span class="value">{{ stockInfo.roe ? stockInfo.roe + '%' : '-' }}</span>
                </div>
                <div class="info-item">
                  <span class="label">每股收益</span>
                  <span class="value">{{ stockInfo.eps || '-' }}</span>
                </div>
              </div>
            </el-card>

            <!-- 指标读数 -->
            <el-card v-if="indicatorValues" class="indicator-values">
              <template #header>指标值</template>
              <div v-for="(value, key) in indicatorValues" :key="key" class="indicator-item">
                <span class="label">{{ key }}</span>
                <span class="value">{{ formatIndicatorValue(value) }}</span>
              </div>
            </el-card>

            <!-- 筹码信息 -->
            <el-card v-if="chipData && chipData.features" class="chip-info-card">
              <template #header>
                <span>筹码分析</span>
              </template>
              <div class="chip-info-grid">
                <div class="info-item">
                  <span class="label">平均成本</span>
                  <span class="value">{{ chipData.features.average_cost ? '¥' + chipData.features.average_cost : '-' }}</span>
                </div>
                <div class="info-item">
                  <span class="label">获利比例</span>
                  <span class="value" :class="getChangeClass(chipData.features.profit_ratio)">{{ chipData.features.profit_ratio || 0 }}%</span>
                </div>
                <div class="info-item">
                  <span class="label">筹码集中度</span>
                  <span class="value">{{ chipData.features.concentration || 0 }}%</span>
                </div>
                <div class="info-item">
                  <span class="label">成本重心</span>
                  <span class="value">{{ chipData.features.cost_center ? '¥' + chipData.features.cost_center : '-' }}</span>
                </div>
                <div class="info-item">
                  <span class="label">套牢筹码</span>
                  <span class="value">{{ chipData.features.trapped_above || 0 }}%</span>
                </div>
                <div class="info-item">
                  <span class="label">浮盈比例</span>
                  <span class="value" :class="getChangeClass(chipData.features.profit_loss_ratio)">{{ chipData.features.profit_loss_ratio || 0 }}%</span>
                </div>
              </div>
            </el-card>

            <!-- 信号提示 -->
            <el-card v-if="signals.length > 0" class="signals">
              <div slot="header">信号提示</div>
              <div v-for="signal in signals" :key="signal.id" class="signal-item">
                <el-tag :type="signal.type" size="small">{{ signal.name }}</el-tag>
                <span class="time">{{ signal.time }}</span>
              </div>
            </el-card>
          </div>
        </el-col>
      </el-row>
    </div>

    <!-- 指标管理器 -->
    <IndicatorManager
        v-if="showIndicatorManager"
        :selected-indicators="selectedIndicators"
        :visible="showIndicatorManager"
        @apply="applyIndicators"
        @close="showIndicatorManager = false"
    />
  </div>
</template>

<script>
import {onBeforeUnmount, onMounted, ref} from 'vue'
import {ElMessage} from 'element-plus'
import {Refresh, Setting} from '@element-plus/icons-vue'
import * as echarts from 'echarts'
import {calculateIndicators, ChartWebSocket, getSeries, getSnapshot, getStockInfo, getChipDistribution, getStockList} from '@/api/chart'
import IndicatorManager from '@/components/IndicatorManager.vue'

export default {
  name: 'SymbolChart',
  components: {
    IndicatorManager,
    Setting,
    Refresh
  },
  setup() {
    // 图表相关
    const chartContainer = ref(null)
    const chipChartContainer = ref(null)
    let chartInstance = null
    let chipChartInstance = null
    const chartHeight = ref(600)

    // 数据相关
    const symbol = ref('000001')
    const timeframe = ref('1d')
    const adjust = ref('qfq')  // 默认前复权
    const loading = ref(false)
    const realtime = ref(false)
    const stockList = ref([])  // 股票列表缓存

    // K线数据
    const seriesData = ref(null)
    const bars = ref([])
    const snapshot = ref(null)
    const stockInfo = ref(null)

    // 指标相关
    const mainIndicator = ref('BOLL')  // 默认主图指标为BOLL
    const selectedIndicators = ref([
      {name: 'BOLL', params: {period: 20, std_dev: 2}, pane: 'main'},
      {name: 'Volume', params: {}, pane: 'sub1'},
      {name: 'MACD', params: {}, pane: 'sub2'}
    ])
    const indicatorData = ref({})
    const indicatorValues = ref({})
    const showIndicatorManager = ref(false)

    // 信号和提示
    const signals = ref([])

    // UI相关
    const showSidebar = ref(true)
    const showChipChart = ref(true)  // 默认显示筹码峰
    const chipData = ref(null)
    const currentTemplate = ref('default')
    const showMoreTimeframes = ref(false)  // 显示更多周期

    // WebSocket
    let chartWs = null
    let subscriptionId = null

    // 主要时间周期
    const mainTimeframes = [
      {label: '分时', value: '1m'},
      {label: '日K', value: '1d'},
      {label: '周K', value: '1w'},
      {label: '月K', value: '1mo'},
      {label: '五日', value: '5d'}
    ]
    
    // 更多时间周期
    const moreTimeframes = [
      {label: '1分', value: '1m'},
      {label: '5分', value: '5m'},
      {label: '15分', value: '15m'},
      {label: '30分', value: '30m'},
      {label: '60分', value: '60m'},
      {label: '120分', value: '120m'},
      {label: '年K', value: '1y'}
    ]
    
    // 所有时间周期（用于兼容）
    const timeframes = [...mainTimeframes, ...moreTimeframes]

    // 模板选项
    const templates = [
      {
        id: 'default', name: '默认', indicators: [
          {name: 'BOLL', params: {period: 20, std_dev: 2}, pane: 'main'},
          {name: 'Volume', params: {}, pane: 'sub1'}
        ]
      },
      {
        id: 'trend', name: '趋势', indicators: [
          {name: 'MA', params: {periods: [5, 10, 20, 60]}, pane: 'main'},
          {name: 'MACD', params: {}, pane: 'sub1'},
          {name: 'Volume', params: {}, pane: 'sub2'}
        ]
      },
      {
        id: 'momentum', name: '动量', indicators: [
          {name: 'BOLL', params: {}, pane: 'main'},
          {name: 'RSI', params: {}, pane: 'sub1'},
          {name: 'KDJ', params: {}, pane: 'sub2'}
        ]
      },
      {
        id: 'volume', name: '量能', indicators: [
          {name: 'VWAP', params: {}, pane: 'main'},
          {name: 'Volume', params: {}, pane: 'sub1'},
          {name: 'OBV', params: {}, pane: 'sub2'}
        ]
      }
    ]

    // 加载数据
    const loadData = async () => {
      loading.value = true
      try {
        // 并行获取股票信息和K线数据
        const [infoResponse, seriesResponse] = await Promise.all([
          getStockInfo(symbol.value).catch(err => {
            console.error('获取股票信息失败:', err)
            return null
          }),
          getSeries({
            symbol: symbol.value,
            timeframe: timeframe.value,
            adjust: adjust.value,
            limit: 500
          })
        ])

        if (infoResponse) {
          stockInfo.value = infoResponse
        }

        seriesData.value = seriesResponse
        bars.value = seriesResponse.bars || []

        // 计算指标
        if (selectedIndicators.value.length > 0) {
          await loadIndicators()
        }

        // 获取快照
        if (realtime.value) {
          const snap = await getSnapshot(symbol.value)
          snapshot.value = snap
        }

        // 更新图表
        updateChart()
        
        // 如果筹码峰开启，加载并更新筹码数据
        if (showChipChart.value) {
          await loadChipDistribution()
        }

      } catch (error) {
        console.error('加载数据失败:', error)
        ElMessage.error('加载数据失败')
      } finally {
        loading.value = false
      }
    }

    // 加载指标
    const loadIndicators = async () => {
      try {
        const response = await calculateIndicators({
          symbol: symbol.value,
          timeframe: timeframe.value,
          adjust: adjust.value,
          indicators: selectedIndicators.value
        })

        indicatorData.value = response

        // 更新最新指标值
        updateIndicatorValues()

      } catch (error) {
        console.error('计算指标失败:', error)
        ElMessage.error('计算指标失败')
      }
    }

    // 初始化图表
    const initChart = () => {
      if (!chartContainer.value) return

      chartInstance = echarts.init(chartContainer.value)

      // 基础配置
      const option = {
        animation: false,
        grid: [],
        xAxis: [],
        yAxis: [],
        series: [],
        dataZoom: [
          {
            type: 'inside',
            xAxisIndex: [0, 1, 2],
            start: 80,
            end: 100
          },
          {
            type: 'slider',
            xAxisIndex: [0, 1, 2],
            start: 80,
            end: 100,
            bottom: 10
          }
        ],
        tooltip: {
          trigger: 'axis',
          axisPointer: {
            type: 'cross'
          },
          formatter: (params) => {
            return formatTooltip(params)
          }
        }
      }

      chartInstance.setOption(option)

      // 监听缩放事件
      chartInstance.on('datazoom', () => {
        updateIndicatorValues()
      })
    }

    // 更新图表
    const updateChart = () => {
      if (!chartInstance || !bars.value.length) return

      // 准备数据
      const categoryData = bars.value.map(item => {
        // 处理时间格式，去掉不必要的T00:00:00
        let ts = item.ts
        if (typeof ts === 'string' && ts.includes('T') && (timeframe.value === '1d' || timeframe.value === '1w' || timeframe.value === '1mo')) {
          ts = ts.split('T')[0]
        }
        return ts
      })
      const klineData = bars.value.map(item => [
        item.open,
        item.close,
        item.low,
        item.high
      ])
      const volumeData = bars.value.map((item, index) => {
        const color = item.close >= item.open ? '#ec0000' : '#00da3c'
        return {
          value: item.volume,
          itemStyle: {color}
        }
      })

      // 配置网格布局
      const grids = [
        {left: '10%', right: '10%', top: '10%', height: '50%'},  // 主图
        {left: '10%', right: '10%', top: '65%', height: '15%'},  // 成交量
        {left: '10%', right: '10%', top: '83%', height: '10%'}   // 其他指标
      ]

      // 配置X轴
      const xAxes = grids.map((grid, index) => ({
        type: 'category',
        data: categoryData,
        gridIndex: index,
        axisLine: {onZero: false},
        splitLine: {show: false},
        axisLabel: {
          show: index === grids.length - 1,
          formatter: (value) => formatTimeLabel(value, timeframe.value),
          rotate: 0,
          interval: 'auto'
        }
      }))

      // 配置Y轴
      const yAxes = [
        {
          gridIndex: 0,
          splitArea: {show: true}
        },
        {
          gridIndex: 1,
          splitArea: {show: false}
        },
        {
          gridIndex: 2,
          splitArea: {show: false}
        }
      ]

      // 配置系列
      const series = [
        {
          name: 'K线',
          type: 'candlestick',
          data: klineData,
          xAxisIndex: 0,
          yAxisIndex: 0,
          itemStyle: {
            color: '#ec0000',
            color0: '#00da3c',
            borderColor: '#ec0000',
            borderColor0: '#00da3c'
          }
        },
        {
          name: '成交量',
          type: 'bar',
          data: volumeData,
          xAxisIndex: 1,
          yAxisIndex: 1
        }
      ]

      // 添加指标线
      addIndicatorSeries(series, grids)

      // 更新配置
      const option = {
        grid: grids,
        xAxis: xAxes,
        yAxis: yAxes,
        series: series
      }

      chartInstance.setOption(option)
    }

    // 添加指标系列
    const addIndicatorSeries = (series, grids) => {
      Object.entries(indicatorData.value).forEach(([name, indicator]) => {
        const pane = indicator.pane
        let gridIndex = 0

        if (pane === 'main') {
          gridIndex = 0
        } else if (pane === 'sub1') {
          gridIndex = 1
        } else if (pane === 'sub2') {
          gridIndex = 2
        }

        // 添加每个指标线
        Object.entries(indicator.series || {}).forEach(([key, values]) => {
          series.push({
            name: key,
            type: 'line',
            data: values,
            xAxisIndex: gridIndex,
            yAxisIndex: gridIndex,
            smooth: true,
            lineStyle: {
              width: 1
            },
            showSymbol: false
          })
        })
      })
    }

    // 更新指标值
    const updateIndicatorValues = () => {
      if (!chartInstance) return

      const dataIndex = bars.value.length - 1
      const values = {}

      Object.entries(indicatorData.value).forEach(([name, indicator]) => {
        Object.entries(indicator.series || {}).forEach(([key, data]) => {
          if (data && data[dataIndex] !== undefined) {
            values[key] = data[dataIndex]
          }
        })
      })

      indicatorValues.value = values
    }

    // 切换时间周期
    const changeTimeframe = (tf) => {
      timeframe.value = tf
      loadData()
    }

    // 应用模板
    const applyTemplate = () => {
      const template = templates.find(t => t.id === currentTemplate.value)
      if (template) {
        selectedIndicators.value = [...template.indicators]
        loadData()
      }
    }

    // 应用指标
    const applyIndicators = (indicators) => {
      selectedIndicators.value = indicators
      loadIndicators()
      updateChart()
    }

    // 切换主图指标
    const changeMainIndicator = () => {
      // 移除当前主图指标
      selectedIndicators.value = selectedIndicators.value.filter(ind => ind.pane !== 'main')
      
      // 添加新的主图指标
      if (mainIndicator.value !== 'none') {
        let indicatorConfig = null
        switch (mainIndicator.value) {
          case 'MA':
            indicatorConfig = {name: 'MA', params: {periods: [5, 10, 20, 60]}, pane: 'main'}
            break
          case 'EXPMA':
            indicatorConfig = {name: 'EXPMA', params: {periods: [12, 50]}, pane: 'main'}
            break
          case 'BOLL':
            indicatorConfig = {name: 'BOLL', params: {period: 20, std_dev: 2}, pane: 'main'}
            break
          case 'ENE':
            indicatorConfig = {name: 'ENE', params: {period: 10, k1: 11, k2: 9}, pane: 'main'}
            break
        }
        if (indicatorConfig) {
          selectedIndicators.value.unshift(indicatorConfig)
        }
      }
      
      // 重新加载数据
      loadData()
    }

    // 切换筹码峰显示
    const toggleChipChart = async () => {
      if (showChipChart.value) {
        // 加载筹码分布数据
        await loadChipDistribution()
      } else {
        // 销毁筹码峰图表
        if (chipChartInstance) {
          chipChartInstance.dispose()
          chipChartInstance = null
        }
      }
    }

    // 加载筹码分布数据
    const loadChipDistribution = async () => {
      try {
        const response = await getChipDistribution(symbol.value)
        chipData.value = response
        
        // 初始化或更新筹码峰图表
        if (response.price_levels && response.distribution) {
          updateChipChart()
        }
      } catch (error) {
        console.error('加载筹码分布失败:', error)
        ElMessage.error('加载筹码分布失败')
      }
    }

    // 更新筹码峰图表
    const updateChipChart = () => {
      if (!chipChartContainer.value || !chipData.value) return
      
      // 初始化图表实例
      if (!chipChartInstance) {
        chipChartInstance = echarts.init(chipChartContainer.value)
      }
      
      const data = chipData.value
      const currentPrice = data.current_price || snapshot.value?.price || 0
      
      // 获取价格范围
      let priceMin = Math.min(...data.price_levels)
      let priceMax = Math.max(...data.price_levels)
      
      // 如果有主图实例，尝试获取其Y轴范围
      if (chartInstance) {
        try {
          const mainOption = chartInstance.getOption()
          if (mainOption && mainOption.yAxis && mainOption.yAxis[0]) {
            const mainYAxis = mainOption.yAxis[0]
            // 使用主图的实际范围
            if (typeof mainYAxis.min === 'number') priceMin = mainYAxis.min
            if (typeof mainYAxis.max === 'number') priceMax = mainYAxis.max
          }
        } catch (e) {
          console.warn('获取主图Y轴范围失败:', e)
        }
      }
      
      // 准备筹码数据（转换为[price, value]格式）
      const chipSeriesData = data.price_levels.map((price, index) => {
        return [data.distribution[index] || 0, price]
      })
      
      // 配置项
      const option = {
        title: {
          text: '筹码峰',
          textStyle: {
            fontSize: 12
          },
          left: 'center',
          top: '5%'
        },
        tooltip: {
          trigger: 'axis',
          formatter: (params) => {
            if (!params[0]) return ''
            const value = params[0].value
            return `价格: ¥${value[1].toFixed(2)}<br/>筹码: ${value[0].toFixed(2)}%`
          }
        },
        grid: {
          left: '15%',
          right: '10%',
          top: '10%',
          bottom: '10%',
          containLabel: false
        },
        xAxis: {
          type: 'value',
          position: 'top',
          axisLabel: {
            formatter: '{value}%',
            fontSize: 10
          },
          splitLine: {
            show: false
          },
          max: function(value) {
            return Math.ceil(value.max * 1.2)
          }
        },
        yAxis: {
          type: 'value',
          min: priceMin,
          max: priceMax,
          axisLabel: {
            show: true,  // 显示Y轴标签
            fontSize: 10,
            formatter: (value) => value.toFixed(2)
          },
          splitLine: {
            show: false
          }
        },
        series: [
          {
            name: '筹码分布',
            type: 'bar',
            data: chipSeriesData,
            barWidth: 2,
            itemStyle: {
              color: function(params) {
                const price = params.value[1]
                // 获利筹码绿色，套牢筹码红色
                return price < currentPrice ? '#00da3c' : '#ec0000'
              }
            },
            markLine: {
              symbol: 'none',
              data: [
                {
                  yAxis: currentPrice,
                  label: {
                    formatter: '当前',
                    position: 'end',
                    fontSize: 10
                  },
                  lineStyle: {
                    color: '#409eff',
                    type: 'dashed',
                    width: 1
                  }
                }
              ]
            }
          }
        ],
        dataZoom: [
          {
            type: 'inside',
            yAxisIndex: 0,
            start: 0,
            end: 100,
            filterMode: 'none'
          }
        ]
      }
      
      chipChartInstance.setOption(option)
      
      // 同步主图的缩放
      if (chartInstance) {
        // 移除之前的事件监听器
        chartInstance.off('datazoom')
        
        // 添加新的事件监听器
        chartInstance.on('datazoom', (params) => {
          if (chipChartInstance) {
            try {
              const option = chartInstance.getOption()
              if (option.yAxis && option.yAxis[0]) {
                const yAxisMin = option.yAxis[0].min
                const yAxisMax = option.yAxis[0].max
                
                // 更新筹码峰Y轴范围
                chipChartInstance.setOption({
                  yAxis: {
                    min: yAxisMin,
                    max: yAxisMax
                  }
                })
              }
            } catch (e) {
              console.warn('同步Y轴范围失败:', e)
            }
          }
        })
      }
      
      // 窗口大小变化时重新调整
      window.addEventListener('resize', () => {
        if (chipChartInstance) {
          chipChartInstance.resize()
        }
      })
    }

    // 股票搜索
    const queryStock = async (queryString, cb) => {
      if (!queryString) {
        cb([])
        return
      }
      
      try {
        // 先检查缓存
        if (stockList.value.length === 0) {
          // 加载全部股票列表
          const allStocks = await getStockList()
          stockList.value = allStocks || []
        }
        
        const query = queryString.toLowerCase()
        // 支持拼音首字母搜索
        const results = stockList.value.filter(stock => {
          const code = stock.code.toLowerCase()
          const name = stock.name.toLowerCase()
          const pinyin = getPinyin(stock.name).toLowerCase()
          const pinyinFirst = getPinyinFirst(stock.name).toLowerCase()
          
          return code.includes(query) || 
                 name.includes(query) || 
                 pinyin.includes(query) ||
                 pinyinFirst.includes(query)
        }).slice(0, 10)  // 限制显示10条
        
        cb(results)
      } catch (error) {
        console.error('搜索股票失败:', error)
        cb([])
      }
    }
    
    // 选择股票
    const handleStockSelect = (item) => {
      symbol.value = item.code
      loadData()
    }
    
    // 简单的拼音转换（首字母）
    const getPinyinFirst = (str) => {
      // 这里是一个简化的实现，实际上可以使用pinyin库
      const pinyinMap = {
        '平': 'p', '安': 'a', '银': 'y', '行': 'h',
        '万': 'w', '科': 'k', '招': 'z', '商': 's',
        '浦': 'p', '发': 'f', '长': 'c', '城': 'c',
        '军': 'j', '工': 'g'
        // 可以扩展更多映射
      }
      
      return str.split('').map(char => pinyinMap[char] || char).join('')
    }
    
    // 完整拼音（简化版）
    const getPinyin = (str) => {
      // 实际应用中应该使用专业的pinyin库
      return getPinyinFirst(str)
    }

    // 切换实时模式
    const toggleRealtime = async () => {
      if (realtime.value) {
        // 连接WebSocket
        chartWs = new ChartWebSocket()
        await chartWs.connect()

        // 订阅数据
        subscriptionId = chartWs.subscribe(
            symbol.value,
            timeframe.value,
            handleRealtimeData
        )
      } else {
        // 断开WebSocket
        if (chartWs) {
          if (subscriptionId) {
            chartWs.unsubscribe(subscriptionId)
          }
          chartWs.disconnect()
          chartWs = null
        }
      }
    }

    // 处理实时数据
    const handleRealtimeData = (data) => {
      if (data.type === 'bar_update' && data.data) {
        // 更新最后一根K线
        const lastBar = bars.value[bars.value.length - 1]
        if (lastBar) {
          Object.assign(lastBar, data.data)
          updateChart()
        }
      }
    }

    // 格式化时间显示
    const formatTimeLabel = (value, timeframe) => {
      if (!value) return ''
      
      // 处理不同格式的时间字符串
      let dateStr = value
      // 如果包含T，取T之前的部分（去掉时间部分）
      if (typeof value === 'string' && value.includes('T')) {
        dateStr = value.split('T')[0]
        // 如果是分时数据，保留完整时间
        if (timeframe === '1m' || timeframe === '5m' || timeframe === '15m' || timeframe === '30m' || timeframe === '60m') {
          dateStr = value
        }
      }
      
      const date = new Date(dateStr)
      const year = date.getFullYear()
      const month = String(date.getMonth() + 1).padStart(2, '0')
      const day = String(date.getDate()).padStart(2, '0')
      const hours = String(date.getHours()).padStart(2, '0')
      const minutes = String(date.getMinutes()).padStart(2, '0')
      
      // 根据不同周期返回不同格式
      if (timeframe === '1m' || timeframe === '5m' || timeframe === '15m' || timeframe === '30m' || timeframe === '60m') {
        // 分时图显示时间
        return `${hours}:${minutes}`
      } else if (timeframe === '1d') {
        // 日线显示月-日
        return `${month}-${day}`
      } else if (timeframe === '1w') {
        // 周线显示月/日
        return `${month}/${day}`
      } else if (timeframe === '1mo') {
        // 月线显示年/月
        return `${year}/${month}`
      }
      return `${month}-${day}`
    }

    // 格式化日期显示（用于tooltip等详细信息）
    const formatDateDisplay = (value, timeframe) => {
      if (!value) return ''
      
      // 处理不同格式的时间字符串
      let dateStr = value
      // 如果包含T，处理ISO格式
      if (typeof value === 'string' && value.includes('T')) {
        // 如果是日线数据，直接取日期部分
        if (timeframe === '1d' || timeframe === '1w' || timeframe === '1mo') {
          dateStr = value.split('T')[0]
        }
      }
      
      const date = new Date(dateStr)
      const year = date.getFullYear()
      const month = String(date.getMonth() + 1).padStart(2, '0')
      const day = String(date.getDate()).padStart(2, '0')
      const hours = String(date.getHours()).padStart(2, '0')
      const minutes = String(date.getMinutes()).padStart(2, '0')
      
      // 分时图显示完整时间
      if (timeframe === '1m' || timeframe === '5m' || timeframe === '15m' || timeframe === '30m' || timeframe === '60m') {
        return `${year}/${month}/${day} ${hours}:${minutes}`
      }
      // 其他周期只显示日期
      return `${year}/${month}/${day}`
    }

    // 格式化Tooltip
    const formatTooltip = (params) => {
      if (!params || params.length === 0) return ''

      const dataIndex = params[0].dataIndex
      const bar = bars.value[dataIndex]
      if (!bar) return ''

      let html = `<div style="padding: 10px;">
        <div>${formatDateDisplay(bar.ts, timeframe.value)}</div>
        <div>开: ${formatNumber(bar.open)}</div>
        <div>高: ${formatNumber(bar.high)}</div>
        <div>低: ${formatNumber(bar.low)}</div>
        <div>收: ${formatNumber(bar.close)}</div>
        <div>量: ${formatVolume(bar.volume)}</div>
        <div>额: ${formatAmount(bar.amount)}</div>`

      // 添加指标值
      params.forEach(param => {
        if (param.seriesName !== 'K线' && param.seriesName !== '成交量') {
          html += `<div>${param.seriesName}: ${formatNumber(param.value)}</div>`
        }
      })

      html += '</div>'
      return html
    }

    // 工具函数
    const getChangeClass = (value) => {
      if (value > 0) return 'rise'
      if (value < 0) return 'fall'
      return 'flat'
    }

    const formatNumber = (value) => {
      if (!value && value !== 0) return '-'
      return Number(value).toFixed(2)
    }

    const formatVolume = (value) => {
      if (!value) return '0'
      if (value >= 100000000) {
        return (value / 100000000).toFixed(2) + '亿'
      } else if (value >= 10000) {
        return (value / 10000).toFixed(2) + '万'
      }
      return value.toString()
    }

    const formatAmount = (value) => {
      if (!value) return '0'
      if (value >= 100000000) {
        return (value / 100000000).toFixed(2) + '亿'
      } else if (value >= 10000) {
        return (value / 10000).toFixed(2) + '万'
      }
      return value.toString()
    }

    const formatIndicatorValue = (value) => {
      if (typeof value === 'number') {
        return value.toFixed(2)
      }
      return value
    }

    const formatMarketCap = (value) => {
      if (!value) return '-'
      if (value >= 1000000000000) {
        return (value / 1000000000000).toFixed(2) + '万亿'
      } else if (value >= 100000000) {
        return (value / 100000000).toFixed(2) + '亿'
      } else if (value >= 10000) {
        return (value / 10000).toFixed(2) + '万'
      }
      return value.toString()
    }

    // 生命周期
    onMounted(() => {
      initChart()
      loadData()

      // 监听窗口大小变化
      window.addEventListener('resize', () => {
        if (chartInstance) {
          chartInstance.resize()
        }
        if (chipChartInstance) {
          chipChartInstance.resize()
        }
      })
    })

    onBeforeUnmount(() => {
      // 清理图表
      if (chartInstance) {
        chartInstance.dispose()
      }
      if (chipChartInstance) {
        chipChartInstance.dispose()
      }

      // 断开WebSocket
      if (chartWs) {
        chartWs.disconnect()
      }

      // 移除事件监听
      window.removeEventListener('resize', () => {
      })
    })

    return {
      // refs
      chartContainer,
      chipChartContainer,

      // data
      symbol,
      timeframe,
      adjust,
      loading,
      realtime,
      bars,
      snapshot,
      stockInfo,
      mainIndicator,
      selectedIndicators,
      indicatorValues,
      signals,
      showIndicatorManager,
      showSidebar,
      showChipChart,
      chipData,
      currentTemplate,
      showMoreTimeframes,
      mainTimeframes,
      moreTimeframes,

      // computed
      timeframes,
      templates,
      chartHeight,

      // methods
      loadData,
      queryStock,
      handleStockSelect,
      changeTimeframe,
      applyTemplate,
      applyIndicators,
      changeMainIndicator,
      toggleChipChart,
      toggleRealtime,
      getChangeClass,
      formatNumber,
      formatVolume,
      formatAmount,
      formatIndicatorValue,
      formatMarketCap
    }
  }
}
</script>

<style scoped>
.chart-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}

/* 股票信息栏 */
.stock-info-bar {
  padding: 10px 20px;
  background: #f8f9fa;
  border-bottom: 1px solid #e4e7ed;
}

.stock-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stock-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.stock-name {
  font-size: 18px;
  font-weight: bold;
  color: #303133;
}

.stock-code {
  font-size: 14px;
  color: #606266;
}

.stock-tags {
  display: flex;
  gap: 8px;
  align-items: center;
}

.stock-market {
  padding: 2px 8px;
  background: #409eff;
  color: white;
  font-size: 12px;
  border-radius: 3px;
}

.stock-tag {
  padding: 2px 6px;
  font-size: 12px;
  border-radius: 3px;
  color: white;
}

.stock-tag.margin {
  background: #f56c6c;
}

.stock-tag.hgt {
  background: #67c23a;
}

.stock-tag.sgt {
  background: #e6a23c;
}

/* 股票信息卡片 */
.stock-info-card .info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}

.stock-info-card .info-item {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  padding: 4px 0;
  border-bottom: 1px solid #f0f0f0;
}

.stock-info-card .info-item:last-child {
  border-bottom: none;
}

.stock-info-card .info-item .label {
  color: #909399;
}

.stock-info-card .info-item .value {
  color: #303133;
  font-weight: 500;
}

/* 筹码信息卡片 */
.chip-info-card .chip-info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}

.chip-info-card .info-item {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  padding: 4px 0;
  border-bottom: 1px solid #f0f0f0;
}

.chip-info-card .info-item:last-child {
  border-bottom: none;
}

.chip-info-card .info-item .label {
  color: #909399;
}

.chip-info-card .info-item .value {
  color: #303133;
  font-weight: 500;
}

.chart-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 20px;
  border-bottom: 1px solid #e4e7ed;
  background: #f5f7fa;
}

.toolbar-left,
.toolbar-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.timeframe-selector {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.timeframe-group {
  margin: 0;
}

.timeframe-group-more {
  margin-top: 5px;
}

.chart-main {
  flex: 1;
  padding: 20px;
  overflow: hidden;
}

.echarts-container {
  width: 100%;
  min-height: 600px;
}

/* 筹码峰图表 */
.chip-chart-container {
  width: 100%;
  min-height: 600px;
  background: #ffffff;
  border: 1px solid #e4e7ed;
  border-radius: 4px;
  padding: 5px;
}

/* 侧边栏 */
.sidebar {
  height: 100%;
  overflow-y: auto;
}

.sidebar .el-card {
  margin-bottom: 20px;
}

/* 行情卡片 */
.quote-card .quote-price {
  margin-bottom: 15px;
}

.quote-price .price {
  font-size: 28px;
  font-weight: bold;
  margin-right: 10px;
}

.quote-price .change {
  font-size: 16px;
}

.quote-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
}

.detail-item .label {
  color: #909399;
}

.detail-item .value {
  font-weight: 500;
}

/* 指标值 */
.indicator-values .indicator-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 14px;
}

.indicator-item .label {
  color: #606266;
}

.indicator-item .value {
  font-weight: 500;
  font-family: monospace;
}

/* 信号 */
.signals .signal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.signal-item .time {
  font-size: 12px;
  color: #909399;
}

/* 涨跌样式 */
.rise {
  color: #f56c6c;
}

.fall {
  color: #67c23a;
}

.flat {
  color: #909399;
}

/* 响应式 */
@media (max-width: 1200px) {
  .toolbar-left,
  .toolbar-right {
    flex-wrap: wrap;
  }

  .timeframe-group {
    margin: 5px 0;
  }
}
</style>